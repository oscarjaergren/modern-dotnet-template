# EditorConfig: drives dotnet format and EnforceCodeStyleInBuild. With warnings as errors,
# every rule at `warning` fails the build; the rest stay `suggestion` so consumers aren't fought.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- using directives ---
csharp_using_directive_placement = outside_namespace:warning

# --- modern C# the template relies on ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion

# --- nullability and correctness ---
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8618.severity = error

# --- dead code: unused usings, private members, written-but-unread members, parameters ---
# Unreachable code and unused locals are compiler warnings already.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# --- XML docs: generated for openapi.json; a missing one is fine, a wrong one fails the build ---
dotnet_diagnostic.CS1591.severity = none

# --- trimming / Native AOT: these must never regress on the API ---
# IL2026 RequiresUnreferencedCode, IL3050 RequiresDynamicCode, IL2091 generic mismatch.
dotnet_diagnostic.IL2026.severity = error
dotnet_diagnostic.IL2091.severity = error
dotnet_diagnostic.IL3050.severity = error

# --- naming ---
# First match wins, so const and static readonly (PascalCase) come before private fields.
dotnet_naming_rule.const_fields_pascal.symbols = const_fields
dotnet_naming_rule.const_fields_pascal.style = pascal_case
dotnet_naming_rule.const_fields_pascal.severity = warning
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_accessibilities = *
dotnet_naming_symbols.const_fields.required_modifiers = const

dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# --- exceptions are for bugs; see docs/errors-and-failures.md ---
dotnet_diagnostic.CA1031.severity = error

# --- suppressions: each needs an architectural reason or a genuine tool conflict ---
# CA2007: ConfigureAwait(false) matters only for libraries. ASP.NET Core has no
# SynchronizationContext, so here it would be a no-op on every await.
dotnet_diagnostic.CA2007.severity = none

# MA0004: Meziantou's copy of CA2007, suppressed for the same reason.
dotnet_diagnostic.MA0004.severity = none

[tests/**/*.cs]
# CA1707: test names are sentences with underscores; they carry the explanation that
# xUnit's terse assertion messages don't.
dotnet_diagnostic.CA1707.severity = none
# CA1711: xUnit collection classes end in Collection, which this rule reserves.
dotnet_diagnostic.CA1711.severity = none

[src/AppHost/AppHost.cs]
# MA0048: top-level statements synthesise a Program class. AppHost.cs is Aspire's naming
# convention, kept for readability.
dotnet_diagnostic.MA0048.severity = none
