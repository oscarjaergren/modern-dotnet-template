<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Label="Native AOT">
    <!--
      Native AOT is on by default. It is trivial to keep true while there is no data layer,
      and it is far easier to remove now than to retrofit later.
      To remove it, see docs/native-aot.md — it is a documented exit.
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Container">
    <!--
      SDK container publishing — there is no Dockerfile in this repo by design.
      `dotnet publish -c Release /t:PublishContainer` produces the image.
      NOTE: there is no `-aot` base image family for .NET 10 (those existed only for
      .NET 8/9 on Alpine). `noble-chiseled` is the correct runtime-deps base for an AOT app.
      See docs/containers-and-deployment.md.
    -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <ContainerRepository>modern-dotnet-template-api</ContainerRepository>
    <ContainerImageTags>latest</ContainerImageTags>
  </PropertyGroup>

  <PropertyGroup Label="Validation">
    <!--
      Required to turn on .NET 10's built-in minimal API validation. AddValidation() in Program.cs
      is NOT enough on its own: the generator emits an interceptor, but the compiler ignores it
      unless its namespace is listed here — so every request validates successfully, a silent 200
      where you expected a 400.

      The namespace is Microsoft.Extensions.Validation.Generated. Many blog posts still say
      Microsoft.AspNetCore.Http.Validation.Generated, which was the .NET 10 preview name and
      silently does nothing. Verify against the emitted ValidatableInfoResolver.g.cs, not a post.

      Api.IntegrationTests asserts the 400s precisely so this cannot regress unnoticed.
    -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.Extensions.Validation.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <PropertyGroup Label="OpenAPI">
    <!-- Generate openapi.json at build time so contract changes show up in the PR diff. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="Container port">
    <ContainerPort Include="8080" Type="tcp" />
  </ItemGroup>

  <PropertyGroup Label="Keep debug symbols out of the runtime image">
    <!--
      Native AOT strips symbols into a separate Api.dbg. By default the SDK copies it into the
      publish folder, so it gets baked into the container: 48 MB of symbols on top of a 22 MB
      binary and a 14 MB chiseled base — the image is 3x bigger than the thing it runs.

      This is the supported switch (it gates the _CopyAotSymbols target). Symbolication is not
      lost: the identical Api.dbg is still written to
      artifacts/bin/Api/release_linux-x64/native/ (the artifacts output layout), which CI archives.
    -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- The property above covers the native .dbg; project references still contribute managed .pdbs. -->
  <Target Name="ExcludeManagedSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_SymbolFilesToDrop
        Include="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_SymbolFilesToDrop)" />
    </ItemGroup>
  </Target>

  <!-- Integration and unit tests need to see the endpoint types. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Api.UnitTests" />
    <InternalsVisibleTo Include="Api.ArchitectureTests" />
  </ItemGroup>

</Project>
