<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <!-- Aspire orchestration: development-time only, never deployed, and not AOT. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Aspire's templates opt in; without it the SDK warns ASPIRE010. -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Api.csproj" />
  </ItemGroup>

</Project>
