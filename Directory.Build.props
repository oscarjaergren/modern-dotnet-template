<Project>

  <!--
    Strict on purpose: a failed build tells an agent the work is not done. See
    docs/build-gates.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Gates">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      TreatWarningsAsErrors covers only the compiler; this covers warnings from MSBuild targets,
      such as Aspire's ASPIRE010.
    -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      XML docs feed openapi.json, and let the build check unused usings (IDE0005) and doc comments
      that no longer match the code. A missing doc is fine (CS1591 is off in .editorconfig). The
      files stay out of the published image.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Reproducibility">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Set by CI so builds there are fully deterministic; harmless locally. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Output layout">
    <!--
      All build output under artifacts/, not bin/ and obj/ beside each project. ArtifactsPath is
      explicit because tests/ has its own Directory.Build.props.
    -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
