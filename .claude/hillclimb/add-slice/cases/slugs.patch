+using Api.Infrastructure;
+using Microsoft.AspNetCore.Http.HttpResults;
+
+namespace Api.Features.Slugs;
+
+internal static class SlugsEndpoint
+{
+    internal static IEndpointRouteBuilder MapSlugs(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/slugs", Handle)
+            .WithName("CreateSlug")
+            .WithSummary("Turns a title into a URL slug.")
+            // Not ProducesProblem(400): it would replace the validation schema.
+            .ProducesValidationProblem();
+
+        return app;
+    }
+
+    private static Results<Ok<SlugResponse>, ValidationProblem, ProblemHttpResult> Handle(SlugRequest request)
+    {
+        var slug = Slugifier.Slugify(request.Title);
+        if (slug.IsError)
+        {
+            return slug.FirstError.ToProblem();
+        }
+
+        return TypedResults.Ok(new SlugResponse(slug.Value));
+    }
+}
