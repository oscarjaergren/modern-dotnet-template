@@ -0,0 +1,55 @@
+using System.Net.Http.Json;
+
+namespace Api.IntegrationTests.Features.Slugs;
+
+[Collection(nameof(ApiCollection))]
+public class SlugsEndpointTests(ApiFixture fixture)
+{
+    private Task<HttpResponseMessage> Post(object payload) =>
+        fixture.Client.PostAsJsonAsync("/slugs", payload, TestContext.Current.CancellationToken);
+
+    [Fact]
+    public async Task Post_slugs_returns_the_slug()
+    {
+        using var response = await Post(new { title = "  .NET 10 -- what's new?  " });
+        using var body = await response.ReadJsonAsync();
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("net-10-what-s-new", body.RootElement.GetProperty("slug").GetString());
+    }
+
+    [Fact]
+    public async Task Post_slugs_rejects_a_title_with_no_letters_or_digits()
+    {
+        using var response = await Post(new { title = "?!" });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+    }
+
+    [Fact]
+    public async Task Post_slugs_rejects_an_empty_title()
+    {
+        using var response = await Post(new { title = "" });
+        using var body = await response.ReadJsonAsync();
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.True(body.RootElement.TryGetProperty("errors", out _));
+    }
+
+    [Fact]
+    public async Task Post_slugs_rejects_an_overlong_title()
+    {
+        using var response = await Post(new { title = new string('x', 81) });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Post_slugs_rejects_a_missing_title()
+    {
+        using var response = await Post(new { });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+}
