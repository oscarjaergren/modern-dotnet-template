+using Api.Features.Slugs;
+
+namespace Api.UnitTests.Features.Slugs;
+
+public class SlugifierTests
+{
+    [Theory]
+    [InlineData("Hello, World!", "hello-world")]
+    [InlineData("  .NET 10 -- what's new?  ", "net-10-what-s-new")]
+    [InlineData("already-a-slug", "already-a-slug")]
+    public void Slugify_lowercases_and_hyphenates(string title, string expected) =>
+        Assert.Equal(expected, Slugifier.Slugify(title).Value);
+
+    [Fact]
+    public void Slugify_fails_when_nothing_is_left() =>
+        Assert.True(Slugifier.Slugify("?!").IsError);
+}
