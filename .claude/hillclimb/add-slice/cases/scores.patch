+using Api.Infrastructure;
+using Microsoft.AspNetCore.Http.HttpResults;
+
+namespace Api.Features.Scores;
+
+internal static class ScoresEndpoint
+{
+    internal static IEndpointRouteBuilder MapScores(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/scores", Handle)
+            .WithName("SummariseScores")
+            .WithSummary("Summarises a list of scores.")
+            // Not ProducesProblem(400): it would replace the validation schema.
+            .ProducesValidationProblem();
+
+        return app;
+    }
+
+    private static Results<Ok<ScoresResponse>, ValidationProblem, ProblemHttpResult> Handle(ScoresRequest request)
+    {
+        var summary = ScoreStats.Summarise(request.Values);
+        if (summary.IsError)
+        {
+            return summary.FirstError.ToProblem();
+        }
+
+        return TypedResults.Ok(summary.Value);
+    }
+}
