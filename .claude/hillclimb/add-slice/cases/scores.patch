+using ErrorOr;
+
+namespace Api.Features.Scores;
+
+internal static class ScoreStats
+{
+    // Checked here, not with [Length]: on a collection it needs reflection, which Native AOT forbids.
+    internal static ErrorOr<ScoresResponse> Summarise(IReadOnlyList<int> values) =>
+        values.Count is < 1 or > 50
+            ? Error.Validation("Scores.Count", "Give between 1 and 50 scores.")
+            : new ScoresResponse(values.Count, Math.Round(values.Average(), 1), values.Max());
+}
