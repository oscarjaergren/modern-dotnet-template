+using Api.Features.Scores;
+
+namespace Api.UnitTests.Features.Scores;
+
+public class ScoreStatsTests
+{
+    [Fact]
+    public void Summarise_counts_averages_and_finds_the_max() =>
+        Assert.Equal(new ScoresResponse(3, 6.3, 10), ScoreStats.Summarise([4, 5, 10]).Value);
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(51)]
+    public void Summarise_fails_outside_one_to_fifty_scores(int count) =>
+        Assert.True(ScoreStats.Summarise([.. Enumerable.Repeat(1, count)]).IsError);
+}
