@@ -0,0 +1,48 @@
+using System.Net.Http.Json;
+
+namespace Api.IntegrationTests.Features.Scores;
+
+[Collection(nameof(ApiCollection))]
+public class ScoresEndpointTests(ApiFixture fixture)
+{
+    private static readonly int[] Scores = [4, 5, 10];
+
+    private Task<HttpResponseMessage> Post(object payload) =>
+        fixture.Client.PostAsJsonAsync("/scores", payload, TestContext.Current.CancellationToken);
+
+    [Fact]
+    public async Task Post_scores_returns_the_summary()
+    {
+        using var response = await Post(new { values = Scores });
+        using var body = await response.ReadJsonAsync();
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(3, body.RootElement.GetProperty("count").GetInt32());
+        Assert.Equal(6.3, body.RootElement.GetProperty("mean").GetDouble());
+        Assert.Equal(10, body.RootElement.GetProperty("max").GetInt32());
+    }
+
+    [Fact]
+    public async Task Post_scores_rejects_an_empty_list()
+    {
+        using var response = await Post(new { values = Array.Empty<int>() });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Post_scores_rejects_more_than_fifty()
+    {
+        using var response = await Post(new { values = Enumerable.Repeat(1, 51) });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Post_scores_rejects_a_missing_list()
+    {
+        using var response = await Post(new { });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+}
