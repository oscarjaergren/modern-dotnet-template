<Project>

  <!-- A Directory.Build.props here stops MSBuild walking up, so import the root one first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables running on Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Global usings for every test project. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adds the coverage option to the test runner. Reported in CI, not gated. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

</Project>
